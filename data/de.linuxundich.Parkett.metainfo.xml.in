<?xml version="1.0" encoding="UTF-8"?>
<!-- Copyright 2026 Christoph Langner -->
<component type="desktop-application">
  <id>de.linuxundich.Parkett</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <name>Parkett</name>
  <summary>Terminal with split panes</summary>
  <description>
    <p>Parkett is a terminal for GNOME that arranges several terminals side by side and on top of each other in one tab – like Tilix, but with GTK 4 and libadwaita.</p>
    <ul>
      <li>Tabs with overview and search</li>
      <li>Split panes to the right or below, maximize, equalize and switch them by keyboard</li>
      <li>Profiles with their own command, start directory and behavior when the process exits</li>
      <li>14 color schemes with light and dark variants, import of Ptyxis and Tilix schemes</li>
      <li>Search in the terminal, links by Ctrl+click, customizable shortcuts</li>
      <li>Command palette, layout mode for the keyboard and templates with start commands</li>
      <li>Context color for panes with SSH or root rights, undo when closing</li>
      <li>Asks before closing while a program is still running</li>
      <li>Light and dark style following the system setting</li>
    </ul>
  </description>
  <launchable type="desktop-id">de.linuxundich.Parkett.desktop</launchable>
  <developer id="de.linuxundich">
    <name translate="no">Christoph Langner</name>
  </developer>
  <url type="homepage">https://linuxundich.de/</url>
  <content_rating type="oars-1.1"/>
  <requires>
    <display_length compare="ge">360</display_length>
  </requires>
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
  </supports>
  <provides>
    <binary>parkett</binary>
  </provides>
  <categories>
    <category>System</category>
    <category>TerminalEmulator</category>
  </categories>
  <releases>
    <release version="0.4.0" date="2026-10-23" type="stable">
      <description>
        <p>Input to all panes of a tab, moving panes by dragging (also into other tabs), automatic profile by host or folder, bookmarks for folders, templates for tab names, file paths in the output as links, editing the layout of templates and narrow windows down to 360 pixels.</p>
      </description>
    </release>
    <release version="0.3.0" date="2026-10-23" type="stable">
      <description>
        <p>A second call passes its environment to the new shell, start commands of templates come only after the prompt and never into a password prompt, short tab names, match count in the search, selection in the accent color, color scheme “High Contrast” automatically with high contrast, a normal exit with exit code 0 closes the pane, less load in the background and many fixes.</p>
      </description>
    </release>
    <release version="0.2.0" date="2026-10-19" type="stable">
      <description>
        <p>Restore the session on startup, command line (directory, command, profile, title, tab), context menu in Nautilus, transparent background, font, cursor and bell per profile, notification when a command finishes in the background and many fixes.</p>
      </description>
    </release>
    <release version="0.1.0" date="2026-10-19" type="stable">
      <description>
        <p>First version: tabs and split panes, command palette, layout mode, templates with start commands, profiles, color schemes with light and dark variants, context color for root and SSH, undo when closing, search, links and customizable shortcuts.</p>
      </description>
    </release>
  </releases>
</component>
