<component type="desktop-application">
  <id>de.linuxundich.Parkett</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <name>Parkett</name>
  <summary>Terminal mit geteilten Bereichen</summary>
  <description>
    <p>Parkett ist ein Terminal für GNOME, das mehrere Terminals in einem Reiter nebeneinander und übereinander anordnet – wie Tilix, aber mit GTK 4 und libadwaita.</p>
    <ul>
      <li>Reiter mit Übersicht und Suche</li>
      <li>Bereiche rechts oder unten teilen, maximieren, angleichen und per Tastatur wechseln</li>
      <li>Profile mit eigenem Befehl, Startverzeichnis und Verhalten bei Prozessende</li>
      <li>14 Farbschemata mit heller und dunkler Fassung, Import von Ptyxis- und Tilix-Schemata</li>
      <li>Suche im Terminal, Links per Strg+Klick, änderbare Tastenkürzel</li>
      <li>Befehlspalette, Layout-Modus für die Tastatur und Vorlagen mit Startbefehlen</li>
      <li>Kontextfarbe für Bereiche mit SSH oder Root-Rechten, Rückgängig beim Schließen</li>
      <li>Nachfrage beim Schließen, wenn noch ein Programm läuft</li>
      <li>Helles und dunkles Design nach Systemeinstellung</li>
    </ul>
  </description>
  <launchable type="desktop-id">de.linuxundich.Parkett.desktop</launchable>
  <developer id="de.linuxundich">
    <name translate="no">Christoph Langner</name>
  </developer>
  <url type="homepage">https://linuxundich.de/</url>
  <content_rating type="oars-1.1"/>
  <requires>
    <display_length compare="ge">360</display_length>
  </requires>
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
  </supports>
  <provides>
    <binary>parkett</binary>
  </provides>
  <categories>
    <category>System</category>
    <category>TerminalEmulator</category>
  </categories>
  <releases>
    <release version="0.2.0" date="2026-10-19" type="stable">
      <description>
        <p>Sitzung beim Start wiederherstellen, Befehlszeile (Verzeichnis, Befehl, Profil, Titel, Reiter), Kontextmenü in Nautilus, transparenter Hintergrund, Schrift, Cursor und Glocke je Profil, Benachrichtigung bei Befehlsende im Hintergrund sowie zahlreiche Korrekturen.</p>
      </description>
    </release>
    <release version="0.1.0" date="2026-10-19" type="stable">
      <description>
        <p>Erste Version: Reiter und geteilte Bereiche, Befehlspalette, Layout-Modus, Vorlagen mit Startbefehlen, Profile, Farbschemata mit heller und dunkler Fassung, Kontextfarbe für root und SSH, Rückgängig beim Schließen, Suche, Links und änderbare Tastenkürzel.</p>
      </description>
    </release>
  </releases>
</component>
