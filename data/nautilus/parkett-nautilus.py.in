"""Parkett in the Nautilus context menu (nautilus-python).

Nautilus 51 hard-wires "Open in Console" to GNOME Console; other terminals only get into
the menu through an extension. Opens a new Parkett window, with one tab per folder when
several folders are selected.
"""

from gi.repository import GObject, Gio, Nautilus

PARKETT = "@BINDIR@/parkett"


def _local_dirs(files):
    """Paths of the selected folders; folders without a local path (e.g. without GVfs FUSE) are left out."""
    out = []
    for f in files:
        if not f.is_directory():
            continue
        path = f.get_location().get_path()
        if path:
            out.append(path)
    return out


def _run(paths):
    """One call: one window with a tab per folder (`-d` repeated). Asynchronous so Nautilus
    does not wait; the result is only collected so no zombie is left behind."""
    args = [PARKETT]
    for path in paths:
        args += ["--working-directory", path]
    try:
        proc = Gio.Subprocess.new(args, Gio.SubprocessFlags.NONE)
    except Exception as e:  # Parkett uninstalled, extension still there
        print(f"parkett-nautilus: {e}")
        return
    proc.wait_async(None, lambda p, r: p.wait_finish(r))


class ParkettExtension(GObject.GObject, Nautilus.MenuProvider):
    def get_file_items(self, files):
        paths = _local_dirs(files)
        if not paths:
            return []
        item = Nautilus.MenuItem(
            name="Parkett::open_folders",
            label="In Parkett öffnen",
            tip="Ordner in Parkett öffnen; mehrere Ordner als Reiter",
        )
        item.connect("activate", lambda _item: _run(paths))
        return [item]

    def get_background_items(self, current_folder):
        paths = _local_dirs([current_folder])
        if not paths:
            return []
        item = Nautilus.MenuItem(
            name="Parkett::open_here",
            label="Parkett hier öffnen",
            tip="Diesen Ordner in Parkett öffnen",
        )
        item.connect("activate", lambda _item: _run(paths))
        return [item]
