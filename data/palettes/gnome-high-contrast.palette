# Colors pushed for contrast (QA-10): on white the normal colors 1–6 reach at least 7:1 and
# the bright ones 9–14 at least 4.5:1, on black the other way round. That keeps normal and
# bright distinguishable. 0, 7, 8 and 15 are gray/background tones and stay as they are.
[Palette]
Name=Hoher Kontrast
Primary=true
UseSystemAccent=true

[Light]
Foreground=#000000
Background=#ffffff
TitlebarBackground=#ffffff
TitlebarForeground=#333333
Cursor=#1e1e1e
Color0=#1e1e1e
Color1=#af1924
Color2=#186441
Color3=#735236
Color4=#12488b
Color5=#823995
Color6=#19616b
Color7=#cfcfcf
Color8=#5d5d5d
Color9=#c74f42
Color10=#21864e
Color11=#977008
Color12=#2876d5
Color13=#a955b3
Color14=#218190
Color15=#ffffff

[Dark]
