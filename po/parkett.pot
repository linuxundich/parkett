"Usage: parkett [OPTIONS] [-- COMMAND [ARGUMENTS …]]\n"
"\n"
"  -d, --working-directory=DIR   Start directory; repeat for one tab per directory\n"
"  -e, -x, --                    Run the rest of the line instead of the shell\n"
"                                (-e with a single argument: split like a shell)\n"
"  -p, --profile=ID              Profile (file name without .toml)\n"
"  -t, --title=TITLE             Tab title\n"
