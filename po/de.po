msgstr "Neues Profil"

#: app/src/prefs.rs:178
msgid "A profile defines how a terminal starts and which color scheme it uses."
msgstr "Ein Profil legt fest, wie ein Terminal startet und welches Farbschema es nutzt."

#: app/src/prefs.rs:198
msgid "{scheme} · Default profile"
msgstr "{scheme} · Standardprofil"

#: app/src/prefs.rs:229
msgid "Profile not created: {error}"
msgstr "Profil nicht angelegt: {error}"

#: app/src/prefs.rs:267 app/src/prefs.rs:1401
