#
#: core/src/cli.rs:9
msgid ""
"Usage: parkett [OPTIONS] [-- COMMAND [ARGUMENTS …]]\n"
"\n"
"  -d, --working-directory=DIR   Start directory; repeat for one tab per directory\n"
"  -e, -x, --                    Run the rest of the line instead of the shell\n"
"                                (-e with a single argument: split like a shell)\n"
"  -p, --profile=ID              Profile (file name without .toml)\n"
"  -t, --title=TITLE             Tab title\n"
"      --tab                     Open as a tab in the active window instead of a new window\n"
"      --split-right             Split the active pane of the active window to the right\n"
"      --split-down              Split the active pane of the active window downwards\n"
"  -h, --help                    Show this help\n"
"      --version                 Show version\n"
msgstr ""
"Aufruf: parkett [OPTIONEN] [-- BEFEHL [ARGUMENTE …]]\n"
"\n"
"  -d, --working-directory=DIR   Startverzeichnis; mehrfach = ein Reiter je Verzeichnis\n"
"  -e, -x, --                    Rest der Zeile statt der Shell ausführen\n"
"                                (-e mit nur einem Argument: wie in einer Shell zerlegt)\n"
"  -p, --profile=ID              Profil (Dateiname ohne .toml)\n"
"  -t, --title=TITEL             Titel des Reiters\n"
"      --tab                     als Reiter im aktiven Fenster statt neuem Fenster\n"
"      --split-right             aktiven Bereich des aktiven Fensters rechts teilen\n"
"      --split-down              aktiven Bereich des aktiven Fensters unten teilen\n"
"  -h, --help                    diese Hilfe\n"
"      --version                 Version\n"

