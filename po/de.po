#: app/src/prefs.rs:131
msgid "Shows text with line breaks first – it would run immediately otherwise"
msgstr "Zeigt Text mit Zeilenumbruch vorher – er würde sonst sofort ausgeführt"

#: app/src/prefs.rs:137
msgid "Selected text goes to the clipboard at once"
msgstr "Markierter Text kommt sofort in die Zwischenablage"

#: app/src/prefs.rs:143
msgid "Windows, tabs, splits and directories – without the programs in them"
msgstr "Fenster, Reiter, Aufteilung und Verzeichnisse – ohne die Programme darin"

#: app/src/prefs.rs:149
msgid "After running for at least 10 seconds, when the pane is not visible"
msgstr "Nach mindestens 10 Sekunden Laufzeit, wenn der Bereich nicht zu sehen ist"

